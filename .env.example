# Copie este arquivo para ".env" (nunca comite o ".env" real) e preencha os valores.

# Connection string do cluster MongoDB Atlas.
# Formato: mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
ACADEMIA_MONGODB_URI=

# Nome do banco de dados dentro do cluster (pode ser qualquer nome, ex: academia).
MONGODB_NAME=academia

# Chave secreta do Django. Gere uma nova para produção, por exemplo com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "True" em desenvolvimento local, "False" em produção (Vercel).
DEBUG=True

# Hosts permitidos, separados por vírgula (não precisa incluir *.vercel.app, já é liberado por padrão).
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiáveis para CSRF em produção, separadas por vírgula (ex: domínio customizado).
CSRF_TRUSTED_ORIGINS=
